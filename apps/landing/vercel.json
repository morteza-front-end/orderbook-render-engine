{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/react", "destination": "https://orderbook-render-engine-h5ip.vercel.app/react/" },
    { "source": "/react/", "destination": "https://orderbook-render-engine-h5ip.vercel.app/react/" },
    { "source": "/react/:path*", "destination": "https://orderbook-render-engine-h5ip.vercel.app/react/:path*" },
    { "source": "/nuxt", "destination": "https://orderbook-render-engine-nuxt.vercel.app/nuxt/" },
    { "source": "/nuxt/", "destination": "https://orderbook-render-engine-nuxt.vercel.app/nuxt/" },
    { "source": "/nuxt/:path*", "destination": "https://orderbook-render-engine-nuxt.vercel.app/nuxt/:path*" }
  ]
}
