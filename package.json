{
  "name": "orderbook-render-engine",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:nuxt": "turbo run dev --filter=@orderbook/nuxt-client",
    "dev:react": "turbo run dev --filter=@orderbook/react-client",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:nuxt": "turbo run test:e2e --filter=@orderbook/nuxt-client",
    "test:e2e:react": "turbo run test:e2e --filter=@orderbook/react-client",
    "test:soak": "turbo run test:soak",
    "test:soak:unit": "turbo run test:soak:unit",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  }
}
